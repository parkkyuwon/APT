<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Korean Localization Support -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
	
	<!-- Font Support for Korean Text -->
	<key>UIAppFonts</key>
	<array>
		<string>NotoSansKR-Regular.ttf</string>
		<string>NotoSansKR-Bold.ttf</string>
		<string>NotoSansKR-Medium.ttf</string>
	</array>
	
	<!-- Text Encoding -->
	<key>NSStringEncodingsUsed</key>
	<array>
		<integer>4</integer>
	</array>
</dict>
</plist>
